# Public deployment boundary for emergentism.org.
#
# Vercel deploys from this directory. Keep source/control/tooling files out of
# the uploaded static site; the repository copy remains authoritative.

# Frozen app source pending AIA migration; not a public production surface.
book-pwa/

# K3 public-withholding registry: preserve these exact historical artifact
# bytes in git custody, but never upload them into the public deployment.
app.html
complete-ontology/index.html
five-plus-one/index.html
burrisphere/index.html
dasein/index.html
canon/the-complete-ontology-of-reality/index.html
operators/mf-283-the-orthogonality-theorem-v2/index.html
operators/mf-285-dreams-are-unanchored-d5/index.html
operators/mf-296-gravity-is-time/index.html
operators/mf-298-dark-matter-is-mutual-information/index.html
# The local custody/control registry is audited before build, not published.
withheld-routes.json

# Source/control bundles and local/generated tooling.
docs/
__pycache__/
*.pyc
*.py
*.sh
*.md

# iCloud conflict copies are local custody artifacts, never deploy inputs.
**/* 2.*

# Amrita route: dev-only tooling/tests, not part of the shipped page.
amrita/tools/
amrita/runaway.test.mjs

# Deploy-cuts + boundary hardening (audit 2026-07-04).
# NOTE: gitignore syntax — one pattern per line, no trailing inline comments.
# internal build partials (dev commentary):
partials/
# internal specs, plans, audit reports:
_PLANS/
_STAGING_COMPASS_RESTRUCTURE/
# Vercel build output / project config:
.vercel/
# unused three.js addons (referenced by zero pages):
vendor/three-0.160.0/postprocessing/
vendor/three-0.160.0/shaders/

# Local runtime state if present in the deploy checkout.
.env
.env.*
*.db
*.sqlite
*.sqlite3
*.tsbuildinfo
node_modules/
.next/
dist/
build/
# /build/ is a PUBLIC WING (the 7-wing restructure), not a build artifact — re-include it:
!build/
!build/**

# Archive directories — old versions preserved per K3, not deployed
_archive/
90_ARCHIVE/

# A second, fully indexable front door. /index_legacy_2026_07_19/ returned 200 with a
# homepage-class <title> and no robots rule — a competing homepage exactly when a launch
# invites crawlers. /home/ already 308s to / but the file was still uploaded with 67
# dangling links. Git custody is unaffected; both stay in the repo.
index_legacy_2026_07_19.html
index_legacy_2026_07_19/
home/

