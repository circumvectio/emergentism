{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emergentism.org/schemas/EmergenceStack.v1.schema.json",
  "title": "EmergenceStack.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "stack_id", "version", "scope", "stages", "promotions", "forbidden_skips", "public_projection"],
  "properties": {
    "schema_id": {"const": "emergentism/EmergenceStack.v1"},
    "stack_id": {"const": "EMERGENCE-STACK@1"},
    "version": {"const": 1},
    "scope": {"type": "string", "minLength": 20},
    "stages": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["stage_id", "ordinal", "name", "object_definition", "default_retention", "writers", "expires_when", "promotion_requires"],
        "properties": {
          "stage_id": {"type": "string", "pattern": "^ES-[1-6]$"},
          "ordinal": {"type": "integer", "minimum": 1, "maximum": 6},
          "name": {"enum": ["Signal", "Data", "Information", "Knowledge", "Judgment", "Wisdom"]},
          "object_definition": {"type": "string", "minLength": 12},
          "default_retention": {"type": "string", "minLength": 3},
          "writers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
          "expires_when": {"type": "string", "minLength": 8},
          "promotion_requires": {"type": "array", "items": {"type": "string", "minLength": 3}}
        }
      }
    },
    "promotions": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["promotion_id", "from", "to", "requires_new_object", "requirements"],
        "properties": {
          "promotion_id": {"type": "string", "pattern": "^ESP-[1-5]$"},
          "from": {"type": "string", "pattern": "^ES-[1-5]$"},
          "to": {"type": "string", "pattern": "^ES-[2-6]$"},
          "requires_new_object": {"const": true},
          "requirements": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 3}}
        }
      }
    },
    "forbidden_skips": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 8}},
    "public_projection": {
      "type": "object", "additionalProperties": false,
      "required": ["is_stage", "changes_truth", "changes_maturity", "requires", "states"],
      "properties": {
        "is_stage": {"const": false},
        "changes_truth": {"const": false},
        "changes_maturity": {"const": false},
        "requires": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 3}},
        "states": {"const": ["DRAFT", "AUTHORIZED_NOT_LIT", "LIT", "CORRECTED", "RETRACTED"]}
      }
    }
  }
}
