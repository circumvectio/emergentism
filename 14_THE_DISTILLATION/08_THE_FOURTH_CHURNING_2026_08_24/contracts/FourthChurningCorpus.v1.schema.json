{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emergentism.org/schemas/FourthChurningCorpus.v1.schema.json",
  "title": "FourthChurningCorpus.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "release_id", "date", "authorship", "ai_assistance", "license", "relation_to_third", "third_churning_immutable", "input_hashes", "schema_paths", "diagnosis_order", "collision_order", "public_output_map", "candidate_counts", "pqa_state", "held_out_integrity", "global_philosophy_claim_allowed", "external_states"],
  "properties": {
    "schema_id": {"const": "emergentism/FourthChurningCorpus.v1"},
    "release_id": {"const": "FOURTH-CHURNING-2026-08-24"},
    "date": {"const": "2026-08-24"},
    "authorship": {"const": "Yves R. Burri"},
    "ai_assistance": {"type": "string", "minLength": 8},
    "license": {"const": "CC BY-SA 4.0"},
    "relation_to_third": {"const": "ADDITIVE_OVERLAY"},
    "third_churning_immutable": {"const": true},
    "input_hashes": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 3}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "schema_paths": {"type": "object", "minProperties": 3, "additionalProperties": {"type": "string", "minLength": 3}},
    "diagnosis_order": {"type": "array", "minItems": 54, "maxItems": 54, "uniqueItems": true, "items": {"type": "string"}},
    "collision_order": {"type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "pattern": "^TCX-[0-9]{2}$"}},
    "public_output_map": {"type": "object", "minProperties": 6, "additionalProperties": {"type": "string", "minLength": 3}},
    "candidate_counts": {"type": "object", "additionalProperties": false, "required": ["TYPE_COLLISION", "PARTIAL_TYPE_COLLISION", "NO_COLLISION", "UNDERDETERMINED"], "properties": {"TYPE_COLLISION": {"type": "integer", "minimum": 0}, "PARTIAL_TYPE_COLLISION": {"type": "integer", "minimum": 0}, "NO_COLLISION": {"type": "integer", "minimum": 0}, "UNDERDETERMINED": {"type": "integer", "minimum": 0}}},
    "pqa_state": {"const": {"selected": 54, "evaluated": 0, "independently_reviewed": 0, "resolved": 0}},
    "held_out_integrity": {"const": "CONTAMINATED_FOR_FOURTH_USE"},
    "global_philosophy_claim_allowed": {"const": false},
    "external_states": {"type": "object", "additionalProperties": false, "required": ["deployed", "native_reviewed", "empirically_validated", "training_inclusion_guaranteed"], "properties": {"deployed": {"const": false}, "native_reviewed": {"const": false}, "empirically_validated": {"const": false}, "training_inclusion_guaranteed": {"const": false}}}
  }
}
