{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emergentism.org/schemas/MysteryDiagnosis.v1.schema.json",
  "title": "MysteryDiagnosis.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "diagnosis_id", "problem_id", "pqa_row_sha256", "native_problem", "diagnosis_state", "primary_collision_id", "secondary_collision_ids", "answer_mode", "proposed_effect", "earned_effect", "result_state", "diagnostic_claim", "alleged_invalid_join", "repaired_formulation", "legitimate_bridge", "emergentist_answer", "linked_answer_ids", "native_target_preservation", "strongest_native_rival", "generic_control", "discriminator", "kill_criterion", "cheapest_next_test", "survivor_if_killed", "residual_debt", "split_integrity"],
  "properties": {
    "schema_id": {"const": "emergentism/MysteryDiagnosis.v1"},
    "diagnosis_id": {"type": "string", "pattern": "^MTA54@1:[A-Z]+:[A-Z_]+$"},
    "problem_id": {"type": "string", "pattern": "^PQA54@0\\.1:[A-Z]+:[A-Z_]+$"},
    "pqa_row_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "native_problem": {"type": "string", "minLength": 8},
    "diagnosis_state": {"enum": ["TYPE_COLLISION", "PARTIAL_TYPE_COLLISION", "NO_COLLISION", "UNDERDETERMINED"]},
    "primary_collision_id": {"oneOf": [{"type": "string", "pattern": "^TCX-[0-9]{2}$"}, {"type": "null"}]},
    "secondary_collision_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^TCX-[0-9]{2}$"}},
    "answer_mode": {"enum": ["DIRECT", "TYPE_DIAGNOSIS", "CONSTITUTIVE_REFRAME", "PRACTICAL_ORIENTATION", "CONJECTURE", "OPEN"]},
    "proposed_effect": {"enum": ["FORMAL_CORRECTION", "TYPE_DISSOLUTION", "CONDITIONAL_RESOLUTION", "CLARIFICATION", "REFRAME", "OPEN"]},
    "earned_effect": {"const": "NO_INCREMENT"},
    "result_state": {"const": "SELECTED_UNREVIEWED"},
    "diagnostic_claim": {"type": "string", "minLength": 8},
    "alleged_invalid_join": {"oneOf": [{"type": "string", "minLength": 8}, {"type": "null"}]},
    "repaired_formulation": {"type": "string", "minLength": 8},
    "legitimate_bridge": {"type": "string", "minLength": 8},
    "emergentist_answer": {"type": "string", "minLength": 8},
    "linked_answer_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^EA-[0-9]{2}$"}},
    "native_target_preservation": {"const": "PRESERVED"},
    "strongest_native_rival": {"type": "string", "minLength": 8},
    "generic_control": {"type": "string", "minLength": 8},
    "discriminator": {"type": "string", "minLength": 8},
    "kill_criterion": {"type": "string", "minLength": 8},
    "cheapest_next_test": {"type": "string", "minLength": 8},
    "survivor_if_killed": {"type": "string", "minLength": 8},
    "residual_debt": {"type": "string", "minLength": 3},
    "split_integrity": {"const": "CONTAMINATED_FOR_FOURTH_USE"}
  }
}
