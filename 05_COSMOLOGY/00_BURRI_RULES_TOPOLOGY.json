  "rules": [
    {
      "id": "BR-1",
      "label": "Frame",
      "tier": "D",
      "structuralTier": "S",
      "summary": "The marks 0, 1, and infinity frame a register and never act as operands, agents, causal particles, or deployable operators.",
      "sourceIds": [
        "src-rulebook",
        "src-titan-canon"
      ]
    },
    {
      "id": "BR-2",
      "label": "Crossing",
      "tier": "D",
      "structuralTier": "S",
      "summary": "Each mu-n crossing from Dn to D(n+1), for n zero through five, declares saturation, new freedom, recovery, tier, and kill criterion.",
      "sourceIds": [
        "src-rulebook",
        "src-ledger",
        "src-d4-d5"
      ]
    },
    {
      "id": "BR-3",
      "label": "Constraint",
      "tier": "D",
      "structuralTier": "S",
      "summary": "A constraint removes or reweights lower-law-admissible candidates and does not create a physical future outside the causal possibility set.",
      "sourceIds": [
        "src-rulebook",
        "src-ledger",
        "src-bridge-laws"
      ]
    },
    {
      "id": "BR-4",
      "label": "Commitment",
      "tier": "D",
      "structuralTier": "S",
      "summary": "A finite authorized chi commitment combines option, model, selector, means, and signature to produce a D4 action and receipt.",
      "sourceIds": [
        "src-rulebook",
        "src-ledger",
        "src-d4-d5"
      ]
    },
    {
      "id": "BR-5",
      "label": "Reflexive Return",
      "tier": "D",
      "structuralTier": "S",
      "crosswalkTier": "I",
      "summary": "A receipt returns to the next model and selector while cognitive, execution, and outcome gaps remain distinct.",
      "sourceIds": [
        "src-rulebook",
        "src-ledger",
        "src-soros"
      ]
    },
    {
      "id": "BR-6",
      "label": "Composition",
      "tier": "D",
      "crosswalkTier": "I",
      "summary": "Coupled loops qualify as a candidate Egregoreotype only through a persistent, reweighting, cost-bearing shared trace inside a declared collective boundary.",
      "sourceIds": [
        "src-rulebook",
        "src-ledger",
        "src-egregoreotype"
      ]
    }
