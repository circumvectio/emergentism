{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "emergentism/M4Compression.v1/schema.json",
  "title": "M4Compression.v1",
  "description": "Frozen protocol objects for an M4 lossy-coding run. 'Maximally compressed' is licensed only inside the declared comparator class. The phrase 'game theory exhausted' is barred.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "status",
    "barred_phrases",
    "maximally_compressed_scope",
    "frozen_corpus",
    "encoder",
    "comparator_class",
    "coverage",
    "collisions",
    "rate_distortion",
    "performance_floor",
    "no_placement_option",
    "join_rule"
  ],
  "properties": {
    "id": { "const": "emergentism/M4Compression.v1" },
    "version": { "const": "v1" },
    "status": {
      "type": "string",
      "enum": ["NOT_RUN", "PREREGISTERED", "SCORED", "KILLED"]
    },
    "barred_phrases": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "contains": { "const": "game theory exhausted" },
      "description": "Must include the barred phrase. Do not emit it in prose."
    },
    "maximally_compressed_scope": {
      "type": "string",
      "const": "inside_comparator_class_only"
    },
    "frozen_corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash", "native_game_descriptions", "bearer_indexed_changes", "held_out_targets", "sealed_before_encode"],
      "properties": {
        "hash": { "type": "string", "minLength": 1 },
        "native_game_descriptions": { "type": "array", "items": { "type": "string" } },
        "bearer_indexed_changes": { "type": "array", "items": { "type": "string" } },
        "held_out_targets": { "type": "array", "items": { "type": "string" } },
        "sealed_before_encode": { "type": "boolean", "const": true }
      }
    },
    "encoder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cells", "residual_tag", "total_map"],
      "properties": {
        "id": { "type": "string" },
        "cells": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "string",
            "enum": ["Taking-Φ", "Taking-V", "Giving-Φ", "Giving-V"]
          },
          "uniqueItems": true
        },
        "residual_tag": { "type": "string", "const": "uncoded" },
        "total_map": {
          "type": "string",
          "description": "Each corpus item maps to at most one cell or uncoded."
        }
      }
    },
    "comparator_class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["members", "closed"],
      "properties": {
        "closed": { "type": "boolean", "const": true },
        "members": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string",
            "enum": [
              "M4",
              "native-game-baseline",
              "one-axis-coarser",
              "added-axis-rival",
              "no-placement"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["unique_cell_fraction", "undercoverage_is_fail"],
      "properties": {
        "unique_cell_fraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "undercoverage_is_fail": { "type": "boolean", "const": true }
      }
    },
    "collisions": {
      "type": "object",
      "required": ["count", "necessary_orientation_collapse_kills"],
      "properties": {
        "count": { "type": ["integer", "null"], "minimum": 0 },
        "necessary_orientation_collapse_kills": { "type": "boolean", "const": true }
      }
    },
    "rate_distortion": {
      "type": "object",
      "required": ["rate_measure", "distortion_measure", "curve_points", "no_post_hoc_operating_point"],
      "properties": {
        "rate_measure": { "type": "string" },
        "distortion_measure": { "type": "string" },
        "curve_points": { "type": "array" },
        "no_post_hoc_operating_point": { "type": "boolean", "const": true }
      }
    },
    "performance_floor": {
      "type": "object",
      "required": ["kind", "value", "below_floor_disqualifies_shorter_code"],
      "properties": {
        "kind": { "type": "string", "enum": ["distortion_ceiling", "target_utility_floor"] },
        "value": { "type": ["number", "null"] },
        "below_floor_disqualifies_shorter_code": { "type": "boolean", "const": true }
      }
    },
    "no_placement_option": {
      "type": "object",
      "required": ["always_runnable", "wins_if_meets_floor_at_leq_rate"],
      "properties": {
        "always_runnable": { "type": "boolean", "const": true },
        "wins_if_meets_floor_at_leq_rate": { "type": "boolean", "const": true }
      }
    },
    "join_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "g7_operational",
        "burrisphere_geometric",
        "join"
      ],
      "properties": {
        "g7_operational": { "const": "4+3" },
        "burrisphere_geometric": { "const": "3+1+3" },
        "join": { "const": "named_[I]_projection_only" }
      }
    }
  }
}
