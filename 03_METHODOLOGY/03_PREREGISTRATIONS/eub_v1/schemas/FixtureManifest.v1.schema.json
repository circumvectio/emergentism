{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emergentism.org/schemas/eub/FixtureManifest.v1.schema.json",
  "title": "FixtureManifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "fixture_id", "generator_version", "seed", "seed_commitment_sha256", "split", "truth_custody", "artifacts", "identifiability", "interventions", "reveal_schedule", "hashes"],
  "properties": {
    "schema_id": {"const": "FixtureManifest.v1"},
    "fixture_id": {"type": "string", "minLength": 1},
    "generator_version": {"const": "1.0.0"},
    "seed": {"type": ["integer", "null"]},
    "seed_commitment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "split": {"enum": ["DEVELOPMENT", "VALIDATION", "HELD_OUT"]},
    "truth_custody": {"enum": ["PUBLIC_DEVELOPMENT", "INDEPENDENT_HIDDEN"]},
    "artifacts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "visibility", "media_type"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "visibility": {"type": "string", "minLength": 1}, "media_type": {"type": "string", "minLength": 1}}}},
    "identifiability": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["target_id", "status", "admissible_answer"], "properties": {"target_id": {"type": "string", "minLength": 1}, "status": {"enum": ["POINT_IDENTIFIABLE", "PARTIALLY_IDENTIFIABLE", "NON_IDENTIFIABLE"]}, "admissible_answer": {"type": "string", "minLength": 1}}}},
    "interventions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["intervention_id", "cost", "information_gain", "outcome", "outcome_commitment_sha256"], "properties": {"intervention_id": {"type": "string", "minLength": 1}, "cost": {"type": "number", "minimum": 0}, "information_gain": {"type": "number", "minimum": 0, "maximum": 1}, "outcome": {"type": ["string", "null"]}, "outcome_commitment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "reveal_schedule": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["packet_id", "sitting_id", "packet_sha256", "visibility"], "properties": {"packet_id": {"type": "string", "minLength": 1}, "sitting_id": {"enum": ["UNFOLD", "ATTACK", "SPARK", "CONTACT", "REFLEX_TRANSFER"]}, "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "visibility": {"enum": ["PUBLIC_INITIAL", "CUSTODIAN_REVEAL", "PUBLIC_AFTER_RUN"]}}}},
    "hashes": {"type": "object", "additionalProperties": false, "required": ["public_view_sha256", "hidden_truth_sha256"], "properties": {"public_view_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "hidden_truth_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
