{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "emergentism/PQANormativeBridge.v1",
  "title": "PQANormativeBridge.v1",
  "type": "object",
  "required": ["schema_id", "bridge_id", "descriptive_premises", "normative_premises", "bridge_rule", "bearers", "horizons", "consent", "authority", "justice", "exit", "guardianship_extension", "aggregation_rule", "rivals", "counterexamples", "kill", "survivor", "objectivity_level", "bridge_status"],
