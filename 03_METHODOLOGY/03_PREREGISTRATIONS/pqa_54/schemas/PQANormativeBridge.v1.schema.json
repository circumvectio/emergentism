    "bridge_id": {"type": "string", "minLength": 1},
    "descriptive_premises": {"type": "array", "minItems": 1},
    "normative_premises": {"type": "array", "minItems": 1},
    "bridge_rule": {"type": "string", "minLength": 1},
    "bearers": {"type": "array", "minItems": 1},
    "horizons": {"type": "array", "minItems": 1},
    "consent": {"type": "string", "minLength": 1},
    "authority": {"type": "string", "minLength": 1},
    "justice": {"type": "string", "minLength": 1},
    "exit": {"type": "string", "minLength": 1},
    "guardianship_extension": {"type": ["object", "null"]},
    "aggregation_rule": {"type": "string", "minLength": 1},
    "rivals": {"type": "array", "minItems": 2},
    "counterexamples": {"type": "array", "minItems": 1},
    "kill": {"type": "string", "minLength": 1},
    "survivor": {"type": "string", "minLength": 1},
    "objectivity_level": {"enum": ["NONE", "DEFINITION_STABLE", "PROCEDURALLY_REPRODUCIBLE", "EMPIRICALLY_ADEQUATE", "STANCE_INDEPENDENT"]},
    "bridge_status": {"enum": ["PROPOSED", "VALID_WITHIN_DECLARED_PREMISES", "NARROWED", "UNDERDETERMINED", "KILLED"]}
  },
  "additionalProperties": false
}
